<Window x:Class="Dust7654_Launcher.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dust7654_Launcher"
        xmlns:utility="clr-namespace:Dust7654_Launcher.Utility"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="#0D0D0D"
        Icon="/Resources/logodust.png"
        ResizeMode="NoResize"
        Title="Dust765 Launcher"
        SizeToContent="WidthAndHeight"
        MinWidth="450"
        MinHeight="520">
    <Window.Resources>
        <Style x:Key="HoverGlow" TargetType="FrameworkElement">
            <Setter Property="Effect" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#DADADA"/>
        </Style>
        <Style x:Key="LauncherButton" TargetType="Button">
            <Setter Property="Background" Value="#8B0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#8B0000"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5C0000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Width="450">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="44" Margin="0,0,0,8">
            <Image Source="/Resources/uo_bg.png" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.3" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border Background="#1A1A1A" Opacity="0.85"/>
            <Grid>
                <Label Foreground="#8B0000" FontWeight="Bold" ToolTip="Show or hide change log." MouseUp="ShowNotesButtonUp"
                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" Style="{StaticResource HoverGlow}">
                    <materialIcons:MaterialIcon Kind="Update" Width="32" Height="32"/>
                </Label>
                <materialIcons:MaterialIcon Kind="HammerScrewdriver" Foreground="#8B0000" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"
                                            Style="{StaticResource HoverGlow}">
                    <materialIcons:MaterialIcon.ContextMenu>
                        <ContextMenu x:Name="ToolsMenu">
                            <MenuItem Header="Import Data folder" Click="ImportDataFolder"/>
                            <MenuItem Header="Import ClassicUO Launcher profiles" Click="ImportClassicUOProfiles"/>
                            <MenuItem Header="Force download latest version" Click="ForceDownloadLatest"/>
                            <MenuItem Header="Download latest bleeding edge build" Click="DownloadBleedingEdge"/>
                        </ContextMenu>
                    </materialIcons:MaterialIcon.ContextMenu>
                </materialIcons:MaterialIcon>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="16,0,16,12">
            <Image Source="/Resources/logodust.png" Width="200" Height="200" Stretch="Uniform"
                   VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3"/>
                </Image.Effect>
            </Image>
        </Grid>

        <StackPanel Grid.Row="2" Margin="24,0,24,12">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProfileSelector"
                          Grid.Column="0"
                          Style="{DynamicResource MaterialDesignComboBox}"
                          Foreground="#8B0000"
                          Background="#1A1A1A"
                          materialDesign:TextFieldAssist.UnderlineBrush="#8B0000"
                          BorderBrush="#8B0000"
                          Margin="0,0,8,0"/>
                <materialIcons:MaterialIcon Grid.Column="1" Kind="Settings" Foreground="#8B0000" Width="32" Height="32"
                                            ToolTip="Profiles" MouseUp="ProfileSettingsButtonMouseUp"
                                            Style="{StaticResource HoverGlow}" VerticalAlignment="Center"/>
            </Grid>
            <Button x:Name="PlayButton" Width="402" Height="36" Style="{StaticResource LauncherButton}" Click="PlayButtonClicked">
                Play
            </Button>
            <Label Visibility="Hidden" Name="DownloadProgressLabel" Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,8,0,0"
                   HorizontalAlignment="Center">Downloading an update..</Label>
            <ProgressBar Visibility="Hidden" x:Name="DownloadProgressBar" Height="8" Margin="0,4,0,0"
                         Style="{DynamicResource MaterialDesignLinearProgressBar}" Maximum="100"/>
            <Button x:Name="DownloadUpdateButton" Visibility="Hidden" Height="50" Margin="0,8,0,0"
                    Style="{StaticResource LauncherButton}" Click="DownloadButtonPressed">
                <TextBlock TextAlignment="Center">Update available<LineBreak/>Download now</TextBlock>
            </Button>
        </StackPanel>

        <Border Grid.Row="5" Background="#121212" Padding="16,12" Margin="0,8,0,0">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Name="VersionRectangle" Grid.Row="0" Content="{x:Static local:LauncherSettings.LauncherVersionString}"
                           HorizontalContentAlignment="Center" Foreground="#8B0000" FontWeight="SemiBold"/>
                    <Label Name="RemoteVersionText" Grid.Row="1" Visibility="Hidden" HorizontalContentAlignment="Center"
                           Foreground="#A0522D" FontSize="11" Margin="0,2,0,0"/>
                    <Label Name="LocalVersionText" Grid.Row="2" Visibility="Hidden" HorizontalContentAlignment="Center"
                           Foreground="#A0522D" FontSize="11" Margin="0,2,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Image Source="/Resources/discord-mark-blue.png" Width="32" Height="32" Margin="0,0,16,0" Cursor="Hand"
                           ToolTip="Join our discord!" MouseUp="DiscordIconMouseUp" Style="{StaticResource HoverGlow}"/>
                    <Image Source="/Resources/github-mark.png" Width="32" Height="32" Margin="0,0,16,0" Cursor="Hand"
                           ToolTip="Check us out on GitHub" MouseUp="GithubIconMouseUp" Style="{StaticResource HoverGlow}"/>
                    <materialIcons:MaterialIcon Kind="Library" Foreground="#8B0000" Width="32" Height="32" Cursor="Hand"
                                                ToolTip="Open our wiki" MouseUp="WikiMouseUp" Style="{StaticResource HoverGlow}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Name="NewsAreaBorder" Grid.Row="0" Grid.RowSpan="6" Visibility="Collapsed"
                Background="#E6121212" BorderThickness="2" BorderBrush="#8B0000"
                CornerRadius="8" Padding="12" Margin="24,56,24,76"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <ScrollViewer Name="NewsArea" Background="Transparent" Foreground="#FFDADADA"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
        </Border>
    </Grid>
</Window>
